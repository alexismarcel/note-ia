NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=

# Speech-to-text provider: "deepgram" (default) or "soniox".
# This is the rollback path: change the value and redeploy. NEXT_PUBLIC_ vars
# are inlined at build time, so a redeploy is required — but no code change is.
NEXT_PUBLIC_STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
SONIOX_API_KEY=
# Optional: overrides the Soniox real-time model (default stt-rt-preview).
NEXT_PUBLIC_SONIOX_MODEL=

# Stripe — abonnement hebdomadaire.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Dashboard > Developers > Webhooks > l'endpoint > "Signing secret".
# Une valeur par endpoint : celle de la CLI (stripe listen) n'est pas celle de
# la production.
STRIPE_WEBHOOK_SECRET=
# Racine absolue du site, sans slash final, pour les URL de retour de Stripe.
# En production : https://note-ia-nine.vercel.app — en local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=
